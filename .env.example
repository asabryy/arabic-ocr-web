# Database (Postgres, shared by auth-service and doc-manager). Local compose default:
DATABASE_URL=postgresql://textara:textara@postgres:5432/textara

# FastAPI
SECRET_KEY=<your_jwt_secret>
# Email (Resend) — send-only restricted key. Empty disables sending.
RESEND_API_KEY=<your_resend_api_key>
EMAIL_FROM_NAME=Textara
# Where support/feedback submissions are forwarded
SUPPORT_EMAIL=support@textara.app
FEEDBACK_RATE_LIMIT=3/hour
FRONTEND_BASE_URL=<http://localhost:3000 or your live URL>

# Rate limits
REGISTER_RATE_LIMIT=5/minute
LOGIN_RATE_LIMIT=5/minute
CLIENT_IP_HEADER=X-Forwarded-For

# Admin API (auth-service) — leave empty to disable the /admin routes
ADMIN_API_KEY=

# Stripe billing (auth-service) — leave STRIPE_SECRET_KEY empty to disable /billing.
# Prefer a restricted key (rk_...) scoped to Checkout/Customers/Billing Portal.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
# Optional: only this product grants Pro. Empty = any live subscription does.
STRIPE_PRODUCT_PRO=
STRIPE_API_VERSION=2026-08-26.dahlia

# Doc Manager
UPLOAD_DIR=./doc-manager/uploads
STORAGE_BACKEND=local

# OCR — "gemini" (hosted Google Gemini vision) or "http" (self-hosted OCR server)
OCR_BACKEND=gemini
GEMINI_API_KEY=<your_google_ai_studio_api_key>
GEMINI_MODEL=gemini-flash-latest
# Only used when OCR_BACKEND=http
OCR_HTTP_URL=http://localhost:8002

# Plan limits (pages)
PLAN_FREE_DAILY_PAGES=10
PLAN_FREE_MAX_DOC_PAGES=10
PLAN_PRO_DAILY_PAGES=50
PLAN_PRO_MAX_DOC_PAGES=40

# Anonymous landing-page trial
TRIAL_MAX_PAGES=1
TRIAL_RATE_LIMIT=3/day
TRIAL_MAX_UPLOAD_MB=10

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_QUEUE=ocr_tasks
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_URI=

# Cloudflare R2 (optional)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
